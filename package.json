{
  "name": "@practicaljs/react-oauth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/react-oauth.js",
      "require": "./dist/react-oauth.umd.cjs"
    }
  },
  "main": "dist/react-oauth.umd.cjs",
  "module": "dist/react-oauth.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepack": "json -f package.json -I -e \"delete this.devDependencies; delete this.dependencies\"",
    "postpublish": "git checkout ./package.json",
    "test": "vitest",
    "test:deploy": "vitest run"
  },
  "dependencies": {
    "@practicaljs/ts-kit": "^0.1.1",
    "react": ">=17.x",
    "react-dom": ">=17.x"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "jsdom": "30.1.1",
    "json": "11.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vite-plugin-dts": "5.1.1",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=17.x",
    "react-dom": ">=17.x"
  }
}
