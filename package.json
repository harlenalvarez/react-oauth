{
  "name": "@huddle-ai/auth",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/react-oauth.js"
    }
  },
  "main": "./dist/react-oauth.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "vite",
    "build": "npm run check:types && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:deploy": "vitest run",
    "check:router-examples": "tsc --noEmit -p dev/tsconfig.json",
    "dev:mock": "node dev/mock-oauth-server.js",
    "test:release": "node --test scripts/release.node-test.js scripts/release-tag.node-test.js",
    "release-tag": "node scripts/release-tag.js",
    "check:package": "node scripts/check-package.js",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@tanstack/react-router": "^1.170.36",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "json": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^6.2.1",
    "typescript": "^6.0.3",
    "vite": "8.3.1",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vite-plugin-dts": "5.1.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "description": "React OAuth 2.0 authorization code flow with PKCE.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlenalvarez/react-oauth.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
